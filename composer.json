{
    "name": "ephpm/db-codeigniter",
    "description": "CodeIgniter 4 database driver over ePHPm's in-process DB bridge — MySQL-dialect SQL through the ephpm_db_* SAPI functions, no mysqli, no socket round-trips.",
    "type": "library",
    "license": "MIT",
    "keywords": ["codeigniter", "codeigniter4", "database", "driver", "ephpm", "sqlite", "sapi", "turso"],
    "homepage": "https://ephpm.dev",
    "support": {
        "issues": "https://github.com/ephpm/db-codeigniter/issues",
        "source": "https://github.com/ephpm/db-codeigniter"
    },
    "require": {
        "php": "^8.2",
        "codeigniter4/framework": "^4.4 || ^4.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "Ephpm\\Db\\CodeIgniter\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ephpm\\Db\\CodeIgniter\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable"
}
